# ===========================================
# PRODUCTION ENVIRONMENT VARIABLES
# ===========================================
# This file is used when deploying to production (Vercel)
# Also set these in Vercel Dashboard → Settings → Environment Variables

# Backend API URL - Replace with your Vercel backend deployment URL
REACT_APP_API_URL=https://your-backend-project.vercel.app/api

# Backend Base URL (for images/static files — now served from Cloudinary, so this is just the API host)
REACT_APP_BACKEND_URL=https://your-backend-project.vercel.app
