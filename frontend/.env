# ===========================================
# REACT APP ENVIRONMENT VARIABLES
# ===========================================

# Backend API URL (WITH /api suffix)
# Must match the backend port — backend/.env sets PORT=8000 (server.js default 8000)
# For Production: configured in frontend/.env.production / Vercel env vars
REACT_APP_API_URL=http://localhost:8000/api

# Backend Base URL (for images/static files & uploads)
REACT_APP_BACKEND_URL=http://localhost:8000
